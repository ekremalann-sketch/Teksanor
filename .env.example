# Bu dosya yalnızca değişken adlarını belgeler.
# Gerçek değerleri buraya veya Git geçmişine yazmayın.

# Yerel/CI Cloudflare yönetimi
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Uygulama çalışma zamanı kaynakları kod içinde secret olarak tutulmaz.
# D1 ve R2 kaynaklarını Wrangler/Cloudflare Pages binding ayarlarında tanımlayın.
# Önerilen binding adları, mevcut uygulama yapılandırmasıyla eşleştirilmelidir:
# DB=<D1 database binding>
# UPLOADS=<R2 bucket binding>

# E-posta: doğrulanmış gönderici alanı gerekir
RESEND_API_KEY=
MAIL_FROM=
APP_ORIGIN=
# Üretken asistan; eksikken açıkça etiketlenen kayıt özeti kullanılır
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# İsteğe bağlı harici dosya tarayıcısı (POST bytes -> {"clean":true})
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
FILE_SCAN_REQUIRED=false
# Aynı token GitHub Secrets ve hedef uygulamada tanımlanır
APP_CRON_TOKEN=

# İlk hesap kurulumu ve MFA (değerleri yalnızca runtime secrets alanında saklayın).
# Mevcut admin1/admin2 hesabında parola unutulursa ilgili secret'ı yeni güçlü
# parolayla değiştirin. İlk başarılı giriş D1 hash'ini yeniler ve eski oturumları kapatır.
ADMIN1_PASSWORD=
ADMIN2_PASSWORD=
MFA_ENCRYPTION_KEY=
# İki aşamalı doğrulama modu: optional (varsayılan) | required | off
#  optional: kimse kuruluma zorlanmaz; MFA'yı açan kullanıcıya girişte kod sorulur.
#  required: firma sahibi/yöneticiler için kurulum zorunlu (bir kez 14 gün erteleme).
#  off: MFA ne zorlanır ne sorulur. ÖNERİLMEZ; yalnız acil durumda geçici kullanın.
MFA_MODE=optional
# Yapay zekâ izleme (isteğe bağlı): OPENAI_API_KEY tanımlıysa zamanlanmış görev en fazla 30 dk'da bir
# firma başına yalnız toplam sayılardan kısa öneri üretir (isim/serbest metin gönderilmez).
AI_MONITOR_ENABLED=true
