{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teksanor",
  "pages_build_output_dir": "dist/pages",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "production": {
      "d1_databases": [{
        "binding": "DB",
        "database_name": "teksanor-db",
        "database_id": "04330e6e-652b-4b2e-abd9-5d83a9634a71"
      }]
    },
    "preview": {
      "d1_databases": []
    }
  }
}
