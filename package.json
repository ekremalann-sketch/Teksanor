{
  "name": "teksanor-yonetim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "1.24.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.1",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.1.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "build:pages": "vinext build && node scripts/build-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && npm run lint:styles",
    "ci": "npm run lint:styles && npm run typecheck && npm test && npm run build:pages",
    "drill:restore": "node --experimental-strip-types scripts/restore-drill.mjs",
    "lint:styles": "stylelint app/home-design.css app/tokens.css"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "satori": {
      "fflate": "0.7.5"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
