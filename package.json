{
  "name": "teksanor-yonetim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.2",
    "exceljs": "4.4.0",
    "lucide-react": "1.24.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "build:pages": "vinext build && node scripts/build-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "ci": "npm run typecheck && npm test && npm run build:pages",
    "drill:restore": "node --experimental-strip-types scripts/restore-drill.mjs"
  }
}
